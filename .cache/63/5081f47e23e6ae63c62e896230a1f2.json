}},{"source":"src/components/Hero/hero.css","original":{"line":178,"column":0},"generated":{"line":178,"column":0}},{"source":"src/components/Hero/hero.css","original":{"line":179,"column":0},"generated":{"line":179,"column":0}}],"sources":{"src/components/Hero/hero.css":"@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Cedarville+Cursive&family=Great+Vibes&family=Jura:wght@300..700&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Meie+Script&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Parisienne&display=swap');\n.paralax-container {\n    position: relative !important;\n    overflow: hidden !important;\n    width: 100%;\n    height: 1000px; \n    margin: 0 auto; /* Centrage horizontal */\n}\n\n\n.paralax-video {\n    position: absolute; /* Positionnement absolu pour occuper tout l'espace */\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: 1; \n}\n\nvideo {\n    width: 100%;\n    height:100%;\n    object-fit: cover;\n}\n\n.parallax-content {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%); \n    text-align: center;\n    z-index: 2; /* Mettre le contenu au-dessus de la vidéo */\n}\n\n.russian-font h1{\n    font-family: \"Great Vibes\", cursive;\n    font-weight: 400;\n    font-style: normal;\n    text-transform: capitalize;\n    font-size: 70px; \n    color: #fefafa;\n}\n\n.default-font h1{\n    font-size: 70px; \n    color: #fefafa;\n    font-family: \"Parisienne\", cursive;\n    font-weight: 400;\n    font-style: normal;\n    text-transform: capitalize;\n\n}\n\n.default-subtitle {\n    margin-top: 30px;\n    color: #fefafa;\n    font-family: \"Be Vietnam Pro\", sans-serif;\n    font-weight: 300;\n    font-style: normal;\n    line-height: 3; \n    display: block; \n}\n.russian-subtitle{\n    color: #fefafa;\n    font-family: \"Be Vietnam Pro\", sans-serif;\n    font-weight: 300;\n    font-style: normal;\n}\n\n/* Styles du bouton audio */\n.paralax-container button {\n    margin-top: 30px;\n    background: transparent;\n    border: 0.3px solid #fff;\n    border-radius: 50%;\n    width: 65px;\n    height: 65px;\n   \n    cursor: pointer;\n    display: inline-block;\n   \n    position: relative;\n    z-index: 2; \n}\n\n.paralax-container button:hover {\n    opacity: 0.8;\n}\n\n\n\n\n.image-mobile {\n    display: none; \n    width: 100%;\n    height: auto;\n}\n.paralax-video::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(23, 31, 38, 0.5); \n    /* avec 50% de transparence */\n\n\n\n\n    z-index: 1; \n}\n\n\n@media (max-width: 1024px) {\n   \n    .paralax-container {\n        height: 700px; \n    }\n    \n    .paralax-video {\n\n        height: 700px; \n    }\n\n    .default-font h1,\n    .russian-font h1  {\n        font-size: 60px; \n    }\n\n    .default-subtitle,\n    .russian-subtitle {\n        font-size: 14px; \n    }\n}\n\n@media (max-width: 600px) {\n \n    .paralax-container {\n        height: 400px; \n    }\n    \n    .paralax-video {\n        height: 400px; \n    }\n    .paralax-video::before {\n        content: '';\n        position: absolute;\n        top: 0;\n        left: 0;\n        width: 100%;\n        height: 100%;\n        background-color: rgba(0, 0, 0, 0.5); \n    }\n    .parallax-content { \n        padding: 5px; \n       \n    }\n\n    .default-font h1,\n    .russian-font h1 {\n        font-size: 40px; \n        margin-bottom: 5px; \n    }\n\n    .default-subtitle,\n    .russian-subtitle{\n        margin-top: 5px;\n        font-size: 10px; \n        margin-bottom: 10px; \n    }\n\n    .paralax-container button {\n        margin-top: 10px;\n    }\n\n}\n"},"lineCount":179}},"error":null,"hash":"7506f4231f07d41c88e78b20e3ba8fcc","cacheData":{"env":{}}}